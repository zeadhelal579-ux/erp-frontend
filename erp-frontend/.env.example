# تشغيل محلي على باك إند حقيقي (npm run dev):
VITE_API_BASE_URL=http://localhost:5182/api/v1

# تشغيل محلي من غير باك إند (بيانات وهمية جوه المتصفح) -- فعّل السطر ده بدل اللي فوق:
# VITE_USE_MOCK_API=true

# على Vercel: الوضع التجريبي مفعّل تلقائيًا من ملف .env.production.
# لما الباك إند يجهز: اضبط VITE_USE_MOCK_API=false في .env.production (أو في Settings ->
# Environment Variables على Vercel) وأضف VITE_API_BASE_URL بعنوان https:// ينتهي بـ /api/v1
# مثال: VITE_API_BASE_URL=https://erp-api.example.com/api/v1
